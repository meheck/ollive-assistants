# Copy to .env and fill in.

# Frontier assistant AND eval judge -- Google Gemini.
#   assistant = gemini-2.5-flash, judge = gemini-2.5-pro (stronger model judges
#   the weaker one; within-family bias is documented as a known limitation).
GEMINI_API_KEY=...

# Needed only to deploy the OSS model to a Hugging Face Space (write token).
HF_TOKEN=hf_...

# Optional: force the OSS model device (cpu | cuda | mps). Defaults to cpu.
# OSS_DEVICE=cpu
