# Copy to .env and fill in.

# Frontier assistant AND eval judge -- Google Gemini.
#   assistant = gemini-2.5-flash, judge = gemini-2.5-pro (stronger model judges
#   the weaker one; within-family bias is documented as a known limitation).
GEMINI_API_KEY=...

# Needed only to deploy the OSS model to a Hugging Face Space (write token).
HF_TOKEN=hf_...

# Optional: force the OSS model device (cpu | cuda | mps). Defaults to cpu.
# OSS_DEVICE=cpu

# Optional: live tracing to Arize Phoenix. Set this and chat.py / run_evals.py
# stream every turn (spans + tokens + tools + eval verdicts) to the Phoenix UI.
# Unset -> tracing is off and the JSONL trace is the only record.
#   uv sync --extra obs
#   uv run phoenix serve        # http://localhost:6006
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
